DATABASE_URL=postgresql://hanzigo:local-development-only@localhost:5432/hanzigo?schema=public
POSTGRES_PASSWORD=local-development-only
PORT=4000
# Set only behind a reverse proxy you control (e.g. 1 hop, "loopback", or true),
# so rate limiting sees real client IPs. Leave unset for direct exposure.
TRUST_PROXY=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production must use HTTPS and a real transactional email delivery endpoint.
# POST receives {to,subject,text}; Bearer token used for authentication.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
RESET_APP_URL=hanzigo://account
# OpenAI-compatible provider endpoint. Optional; API key stays on server.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

EXPO_PUBLIC_API_URL=http://localhost:4000
