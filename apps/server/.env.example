EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
RESET_APP_URL=hanzigo://account
# OpenAI-compatible provider endpoint. Optional; API key stays on server.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
