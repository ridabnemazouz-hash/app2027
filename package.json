{
  "name": "hanzigo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix apps/mobile run start",
    "web": "npm --prefix apps/mobile run web",
    "server": "tsx watch apps/server/src/main.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/server && tsc --noEmit -p apps/mobile",
    "test": "tsx --test --test-concurrency=1 packages/core/test/*.test.ts apps/server/test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "curriculum:validate": "tsx tools/import-curriculum.ts data/curriculum/supplementary-v1/content.json",
    "db:generate": "prisma generate --schema apps/server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/server/prisma/schema.prisma",
    "db:seed": "tsx apps/server/prisma/seed.ts",
    "export:web": "npm --prefix apps/mobile run export:web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "6.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "expo": "~58.0.21",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react-native": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zod": "^3.24.0"
  }
}
